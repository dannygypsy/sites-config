# /opt/sites/env/groopzone3.env   (copy of this file with real values; chmod 600)
# No quotes around values. Non-secret settings are in compose.yaml.
# Full list with explanations: groopzone3/.env.example

# Database's PRIVATE hostname — same database and user as the old app
DB_HOST=private-groopzone-db-do-user-3419895-0.a.db.ondigitalocean.com
DB_USER=
DB_PASSWORD=

# Long random string, NOT the old app's TOKEN_SECRET:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (same OAuth client as the old app; add
# https://chicharron.groop.zone/api/auth/callback/google as a redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (key "GroopZone Sign in with Apple")
APPLE_CLIENT_ID=zone.groop.signin
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email through Amazon SES (same keys as the old app)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
