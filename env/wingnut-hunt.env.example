# /opt/sites/env/wingnut-hunt.env   (copy of this file with real values; chmod 600)
# No quotes around values.

# Use the database's PRIVATE hostname (starts with "private-"), port 25060
DATABASE_URL=

# Keep the SAME VAPID keys as on k8s, or existing push subscriptions stop working
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
