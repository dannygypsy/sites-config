# /opt/sites/caddy/Caddyfile
# Caddy gets and renews HTTPS certificates for every site listed here.
# After editing:  docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	email danny@wingnutstables.com

	# Prove domain ownership through Cloudflare DNS, so certificates issue
	# and renew whether a record is proxied (orange cloud) or not.
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	servers {
		# Proxied requests arrive from Cloudflare. Trust its published IP
		# ranges and take the visitor's real IP from CF-Connecting-IP.
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

wtc.wingnutstables.com {
	# Same upload limit as the old ingress proxy-body-size
	request_body {
		max_size 50MB
	}
	reverse_proxy wtc-intranet:3000
}

fadretreat.com, www.fadretreat.com, test.fadretreat.com {
	request_body {
		max_size 50MB
	}
	reverse_proxy fadretreat:3001
}

hunt.wingnutstables.com {
	request_body {
		max_size 50MB
	}
	reverse_proxy wingnut-hunt:3000

	# Hunt only runs during events. When it's stopped, say so instead of a bare 502.
	handle_errors 502 503 {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><title>Wingnut Hunt</title><body style=\"font-family:system-ui;text-align:center;padding:4rem 1rem\"><h1>Wingnut Hunt</h1><p>The hunt is closed between events. See you at the next faire!</p></body>" 503
	}
}
